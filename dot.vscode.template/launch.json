        {
            "name": "!!! Dbg:Special Rem Service C++ use native gdb as it has python support so can load .gdbinit. This work because we have the same cpu arch but not recommanded !!!",
            "preLaunchTask": "Tsk:VistaServiceCpp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/${command:cmake.activeConfigurePresetName}/binaries/bin/onbings-vista",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/out/build/all-p6x-debug/binaries",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerServerAddress": "${config:targetHost}:${config:cppGdbPort}",
            "miDebuggerPath": "/opt/rh/gcc-toolset-13/root/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load .gdbinit file",
                    "text": "source ${workspaceFolder}/.gdbinit"
                }
            ]
        },
        {
            "name": "Debug vista Python Client",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/code/sources/onbings-vista-python-client/vista-client.py",
            "args": [
                "--host",
                "xts-005",
                "--port",
                "3000",
                "--command",
                "memory_access",
                "--timeout",
                "9999999999"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopOnEntry": false,
            "justMyCode": true
        }
    ]
}