{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "terminateAllTasks",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "terminateAll"
        },
        {
            "id": "vcpkgProfile",
            "type": "pickString",
            "description": "Select the vcpkg-configuration variant to activate",
            "options": [
                "public",
                "evs"
            ],
            "default": "public"
        }
    ],
    "tasks": [
        {
            "label": "Echo User",
            "type": "shell",
            "command": "echo",
            "args": [
                "Windows User: ${env:USERNAME}",
                "Linux/macOS User: ${env:USER}"
            ]
        },
        {
            "label": "Tsk:SelectVcpkgConfig",
            "detail": "Copy the picked vcpkg-configuration variant (public|evs) into vcpkg-configuration.json before configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-E",
                "copy",
                "${workspaceFolder}/vcpkg-configuration.${input:vcpkgProfile}.json",
                "${workspaceFolder}/vcpkg-configuration.json"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Tsk:BldPrj",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${command:cmake.buildDirectory}"
            ],
            "group": "build",
            "options": {
                "cwd": "${command:cmake.buildDirectory}"
            }
        },
        {
            "label": "Tsk:KillLocal",
            "detail": "Kill local onbing-vista-service/tests instances before building (avoids LNK1168 file lock)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Process -Name onbing-vista-service,onbing-vista-tests -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0"
            ],
            "linux": {
                "command": "bash",
                "args": [
                    "-c",
                    "pkill -9 -f onbing-vista-service; pkill -9 -f onbing-vista-tests; true"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-c",
                    "pkill -9 -f onbing-vista-service; pkill -9 -f onbing-vista-tests; true"
                ]
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Tsk:BldLocalDebug",
            "detail": "Kill local instances then build the active CMake preset for local debugging",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Tsk:KillLocal",
                "Tsk:BldPrj"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Tsk:MkDir",
            "detail": "Create remote deployment directories from .vscode/settings.json",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "mkdir",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "group": "build"
        },
        {
            "label": "Tsk:KillAll",
            "dependsOn": [
                "Tsk:BldPrj"
            ],
            "detail": "Stop remote gdbserver and configured processes",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "stop",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "group": "build",
            "isBackground": false,
            "problemMatcher": []
        },
        {
            "label": "Tsk:TermAllTask",
            "command": "echo ${input:terminateAllTasks}",
            "type": "shell",
            "problemMatcher": []
        },
        {
            "label": "Tsk:DeployDebugArtifact",
            "dependsOn": [
                "Tsk:KillAll",
                "Tsk:MkDir"
            ],
            "detail": "Deploy the all-p6x-debug build to the remote target",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "deploy",
                "all-p6x-debug",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "group": "build"
        },
        {
            "label": "Tsk:DeployReleaseArtifact",
            "dependsOn": [
                "Tsk:KillAll",
                "Tsk:MkDir"
            ],
            "detail": "Deploy the all-p6x-release build to the remote target",
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "deploy",
                "all-p6x-release",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "group": "build"
        },
        {
            "label": "Tsk:vistaTestCpp",
            "detail": "Build, deploy and run vista tests under remote gdbserver",
            "dependsOn": [
                "Tsk:BldPrj"
            ],
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "debug",
                "${command:cmake.activeConfigurePresetName}",
                "bin/onbing-vista-tests"
            ],
            "group": "build",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port [0-9]+",
                    "endsPattern": "Listening on port [0-9]+"
                }
            }
        },
        {
            "label": "Tsk:vistaServiceCpp",
            "detail": "Build, deploy and run the vista service under remote gdbserver",
            "dependsOn": [
                "Tsk:BldPrj"
            ],
            "type": "process",
            "command": "${workspaceFolder}/.vscode/remote-task.sh",
            "args": [
                "debug",
                "${command:cmake.activeConfigurePresetName}",
                "bin/onbing-vista-service"
            ],
            "group": "build",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Listening on port [0-9]+",
                    "endsPattern": "Listening on port [0-9]+"
                }
            }
        }
    ]
}