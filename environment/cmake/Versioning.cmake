# Update version number if needed
if(DEFINED FULL_VERSION)
  string(REPLACE "." ";" VERSION_COMPONENTS ${FULL_VERSION})

  list(LENGTH NB_ITEMS VERSION_COMPONENTS_LENGTH)

  if(NB_ITEMS GREATER 1)
    list(GET VERSION_COMPONENTS 0 PROJECT_VERSION_MAJOR)
    set(CMAKE_PROJECT_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
  endif()
  if(NB_ITEMS GREATER 2)
    list(GET VERSION_COMPONENTS 1 PROJECT_VERSION_MINOR)
    set(CMAKE_PROJECT_VERSION_MINOR ${PROJECT_VERSION_MINOR})
  endif()
  if(NB_ITEMS GREATER 3)
    list(GET VERSION_COMPONENTS 2 PROJECT_VERSION_PATCH)
    set(CMAKE_PROJECT_VERSION_PATCH ${PROJECT_VERSION_PATCH})
  endif()
  if(NB_ITEMS GREATER 4)
    list(GET VERSION_COMPONENTS 3 PROJECT_VERSION_TWEAK)
    set(CMAKE_PROJECT_VERSION_TWEAK ${PROJECT_VERSION_TWEAK})
  endif()

  set(PROJECT_VERSION       ${FULL_VERSION})
  set(CMAKE_PROJECT_VERSION ${FULL_VERSION})

elseif(DEFINED BUILD_NUMBER)

  set(PROJECT_VERSION_TWEAK       ${BUILD_NUMBER})
  set(PROJECT_VERSION             ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}.${PROJECT_VERSION_TWEAK})
  set(CMAKE_PROJECT_VERSION_TWEAK ${BUILD_NUMBER})
  set(CMAKE_PROJECT_VERSION       ${CMAKE_PROJECT_VERSION_MAJOR}.${CMAKE_PROJECT_VERSION_MINOR}.${CMAKE_PROJECT_VERSION_PATCH}.${CMAKE_PROJECT_VERSION_TWEAK})
  
endif()
