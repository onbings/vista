@PACKAGE_INIT@

# Safety check
if(NOT TARGET ONBINGS::onbings-vista)

  # Load the dependencies
  set(FROM_CONFIG_FILE ON)
  include("${CMAKE_CURRENT_LIST_DIR}/onbings-vista-dependencies.cmake")
  unset(FROM_CONFIG_FILE)

  # Load our targets
  include("${CMAKE_CURRENT_LIST_DIR}/onbings-vista-targets.cmake")

  check_required_components(onbings-vista)

endif()
